<!--
  Range 119000-119099. The location conditions keep out lines a local user
  could write to syslog or journald to forge a fact or a service event.
  Never anchor a location with ^: for agent events analysisd matches it
  against the agent name and address followed by the path, while
  wazuh-logtest passes the bare path, so an anchored rule passes logtest and
  never fires on a real agent.
-->
<group name="oscompliance,">

  <rule id="119000" level="0">
    <decoded_as>json</decoded_as>
    <location>/var/log/oscompliance/facts.ndjson$</location>
    <field name="oscompliance" type="pcre2">^1$</field>
    <description>OSCompliance fact envelope v1</description>
  </rule>

  <rule id="119007" level="0">
    <decoded_as>json</decoded_as>
    <location type="pcre2">C:\\ProgramData\\oscompliance\\facts\.ndjson$</location>
    <field name="oscompliance" type="pcre2">^1$</field>
    <description>OSCompliance fact envelope v1 from a Windows agent</description>
  </rule>

  <rule id="119001" level="3">
    <if_sid>119000, 119007</if_sid>
    <field name="fact" type="pcre2">^[a-z][a-z0-9_]*$</field>
    <field name="run_id" type="pcre2">^[0-9a-f-]{36}$</field>
    <description>OSCompliance fact $(fact)</description>
    <group>oscompliance_fact,</group>
  </rule>

  <rule id="119002" level="3">
    <program_name>^oscompliance-agent$</program_name>
    <match>^auth log probe </match>
    <description>OSCompliance authentication log probe</description>
    <group>oscompliance_probe,</group>
  </rule>

  <rule id="119003" level="3">
    <decoded_as>json</decoded_as>
    <location negate="yes" type="pcre2">journald$|syslog|auth\.log|messages|secure|/var/log/oscompliance/|\\oscompliance\\</location>
    <field name="oscompliance_service" type="pcre2">^[A-Za-z0-9][A-Za-z0-9_.-]*$</field>
    <field name="tipo" type="pcre2">^[a-z_]+$</field>
    <description>OSCompliance external authentication event $(tipo) of $(oscompliance_service)</description>
    <group>oscompliance_service,</group>
  </rule>

  <rule id="119004" level="3">
    <if_sid>80700</if_sid>
    <field name="audit.key" type="pcre2">^oscompliance_(read|write|exec|attr|perm)$</field>
    <description>OSCompliance audited access ($(audit.key)) to a watched path</description>
    <group>oscompliance_audit,</group>
  </rule>

  <rule id="119005" level="0">
    <if_sid>119004</if_sid>
    <field name="audit.key" type="pcre2">^oscompliance_read$</field>
    <field name="audit.file.name" type="pcre2">^(?!.*(/\.\.?(/|$)|//))(/etc/(passwd|group|nsswitch\.conf|hosts|host\.conf|resolv\.conf|gai\.conf|services|protocols|shells|login\.defs|localtime|ld\.so\.cache|ld\.so\.conf)$|/etc/(ld\.so\.conf\.d|ssl/certs|ca-certificates|pki/ca-trust)(/|$)|/(usr|lib|lib64)(/|$))</field>
    <description>OSCompliance read of a file every process reads, dropped to protect the disk</description>
  </rule>

  <rule id="119006" level="10">
    <program_name>^oscompliance-agent$</program_name>
    <match>^read watch suspended </match>
    <description>OSCompliance read watch suspended for its volume: reads on that path are not audited for one hour</description>
    <group>oscompliance_audit,</group>
  </rule>

  <rule id="119008" level="10">
    <if_sid>60601</if_sid>
    <field name="win.system.providerName" type="pcre2">^oscompliance-agent$</field>
    <field name="win.system.eventID" type="pcre2">^1006$</field>
    <description>OSCompliance read watch suspended on Windows for its volume: reads on that path are not audited for one hour</description>
    <group>oscompliance_audit,</group>
  </rule>

</group>
