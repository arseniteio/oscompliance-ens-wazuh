{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arseniteio/oscompliance-ens-wazuh/catalog/schemas/verdicts/verdict.v1.json",
  "title": "verdict v1",
  "description": "One document of the oscompliance-verdicts index, written only by the engine: the judgement of one evidence, one requirement or one control on one agent. IDs: evidence agent/control/evidence/run_id ('none' without a pass), requirement agent/control/requirement/day, control agent/control/day.",
  "type": "object",
  "required": [
    "oscompliance_verdict",
    "@timestamp",
    "scope",
    "control",
    "agent",
    "window_start",
    "window_end",
    "engine_version"
  ],
  "properties": {
    "oscompliance_verdict": {
      "const": "1"
    },
    "@timestamp": {
      "description": "Evaluation time.",
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "enum": [
        "evidence",
        "requirement",
        "control",
        "organization"
      ]
    },
    "control": {
      "type": "string",
      "examples": [
        "op.acc.1"
      ]
    },
    "requirement": {
      "type": "string",
      "examples": [
        "op.acc.1.4"
      ]
    },
    "evidence": {
      "type": "string",
      "examples": [
        "EV-01"
      ]
    },
    "agent": {
      "description": "Wazuh agent the facts came from, as Wazuh recorded it.",
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "COMPLIANT",
        "NON_COMPLIANT",
        "NOT_EVALUABLE",
        "NOT_APPLICABLE",
        "PARTIAL"
      ],
      "description": "NOT_EVALUABLE only for evidences (requirements turn it into NON_COMPLIANT, not evidenced); PARTIAL only for controls."
    },
    "cause": {
      "description": "Only with NOT_EVALUABLE.",
      "enum": [
        "COLLECTION",
        "CONFIGURATION",
        "EVIDENCE"
      ]
    },
    "reason": {
      "description": "Why; required unless COMPLIANT.",
      "type": "string"
    },
    "run_id": {
      "description": "Pass judged. Absent when the agent sent no snapshot in the window.",
      "type": "string"
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    },
    "window_end": {
      "type": "string",
      "format": "date-time"
    },
    "engine_version": {
      "type": "string"
    },
    "evidenced": {
      "description": "Requirement scope: false when NON_COMPLIANT comes from a lack of proof, not a measure.",
      "type": "boolean"
    },
    "attested": {
      "description": "Requirement scope: proven by a P-ATT document.",
      "type": "boolean"
    },
    "score": {
      "description": "Control scope: 0-100, absent when nothing applies.",
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "coverage": {
      "description": "Control scope: measured / applicable requirements, %.",
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "applicable_requirements": {
      "type": "integer",
      "minimum": 0
    },
    "measured_requirements": {
      "type": "integer",
      "minimum": 0
    },
    "unmeasured_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maturity": {
      "description": "CMM maturity (Anexo II, apdo. 6). On a control verdict: the level the evidence accredits on that machine (0 to 2) and the working days of the period. On an organization verdict of a measure: the lowest accredited level of its machines and the level, target and author declared in the configuration. On the organization verdict of control ENS: the distribution and global levels.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accredited": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "working_days": {
          "type": "integer",
          "minimum": 0
        },
        "period_days": {
          "type": "integer",
          "minimum": 0
        },
        "assessed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "target": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "assessed_by": {
          "type": "string"
        },
        "assessed_at": {
          "type": "string"
        },
        "references": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "incoherent": {
          "type": "boolean",
          "description": "A declared level of 3 or more on a measure whose evidence accredits less than 2."
        },
        "machines": {
          "type": "integer",
          "minimum": 0
        },
        "applicable": {
          "type": "integer",
          "minimum": 0
        },
        "unmeasured": {
          "type": "integer",
          "minimum": 0
        },
        "unassessed": {
          "type": "integer",
          "minimum": 0
        },
        "below_target": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accredited_counts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 6,
          "maxItems": 6
        },
        "assessed_counts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 6,
          "maxItems": 6
        },
        "global_accredited": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "global_assessed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "tally": {
      "description": "Items counted by the judgement. On an evidence verdict: the items that meet it out of those it judged (copies, accounts). On an organization verdict of a measure: the machines whose control is COMPLIANT out of those it applies to. level is the CMM level of percent on the scale configured in maturity.scales, absent without a scale.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "met",
        "total",
        "percent"
      ],
      "properties": {
        "met": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "compliance": {
      "description": "Control scope: the CMM level of the compliance percentage on the maturity scale (the CCN auditor table in catalog/maturity.json unless maturity.scales sets one) and the level the control's level requires (CCN-STIC 808: L2 BÁSICO, L3 MEDIO, L4 ALTO). The status follows it: COMPLIANT at or above the required level, PARTIAL below it, NON_COMPLIANT at 0 %.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "percent",
        "level",
        "required",
        "category"
      ],
      "properties": {
        "percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "required": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "category": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "NOT_EVALUABLE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "cause",
          "reason"
        ]
      },
      "else": {
        "not": {
          "required": [
            "cause"
          ]
        },
        "if": {
          "properties": {
            "status": {
              "enum": [
                "NON_COMPLIANT",
                "NOT_APPLICABLE",
                "PARTIAL"
              ]
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "required": [
            "reason"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "const": "evidence"
          }
        }
      },
      "then": {
        "required": [
          "evidence"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "requirement"
              ]
            },
            {
              "required": [
                "score"
              ]
            },
            {
              "required": [
                "evidenced"
              ]
            },
            {
              "properties": {
                "status": {
                  "const": "PARTIAL"
                }
              }
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "const": "requirement"
          }
        }
      },
      "then": {
        "required": [
          "requirement"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "evidence"
              ]
            },
            {
              "required": [
                "score"
              ]
            },
            {
              "properties": {
                "status": {
                  "enum": [
                    "NOT_EVALUABLE",
                    "PARTIAL"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "const": "control"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "evidence"
              ]
            },
            {
              "required": [
                "requirement"
              ]
            },
            {
              "properties": {
                "status": {
                  "const": "NOT_EVALUABLE"
                }
              }
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "const": "organization"
          }
        }
      },
      "then": {
        "required": [
          "maturity"
        ],
        "properties": {
          "agent": {
            "properties": {
              "id": {
                "const": "organization"
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "status"
              ]
            },
            {
              "required": [
                "evidence"
              ]
            },
            {
              "required": [
                "requirement"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "status"
        ]
      }
    }
  ]
}
